@@ -1720,7 +1734,29 @@
 		}
 	}
 	endmntent(f);
+#else
+	{
+		struct statfs *mntbuf;
+		int mntcount = getmntinfo(&mntbuf, MNT_NOWAIT);
+		int i;
 
+		if (mntcount <= 0) {
+			if (real_file){ free(real_file); real_file = NULL;}
+			if (real_fsname){ free(real_fsname); real_fsname = NULL;}
+			return -1;
+		}
+
