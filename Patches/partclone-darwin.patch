@@ -1684,8 +1695,10 @@
 int check_mount(const char* device, char* mount_p){
 
 	char *real_file = NULL, *real_fsname = NULL;
+#if defined(__linux__)
 	FILE * f;
 	struct mntent * mnt;
+#endif
 	int isMounted = 0;
 
