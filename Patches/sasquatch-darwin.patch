--- a/squashfs-tools/unsquashfs_info.c
+++ b/squashfs-tools/unsquashfs_info.c
@@ -41,6 +41,70 @@
 #include "unsquashfs.h"
 #include "unsquashfs_error.h"
 
+/*
+ * Darwin does not implement sigtimedwait()/sigwaitinfo(). The info thread only
+ * uses them to pace the status dumps triggered by "\", so provide portable
+ * equivalents built on sigwait() plus a polled wait.
+ */
+#if !defined(__linux__)
+static int squashfs_sigwaitinfo(const sigset_t *set, siginfo_t *info)
+{
+	int sig;
+
+	if(sigwait(set, &sig) != 0)
+		return -1;
+
+	if(info != NULL) {
+		memset(info, 0, sizeof(*info));
+		info->si_signo = sig;
+	}
+
+	return sig;
+}
+
+static int squashfs_sigtimedwait(const sigset_t *set, siginfo_t *info,
+	const struct timespec *timeout)
+{
+	struct timespec elapsed = { 0, 0 };
+	const struct timespec interval = { 0, 100000000 };
+	struct timespec remaining = *timeout;
+	int sig;
+
+	while(1) {
+		sigset_t pending = *set;
+
+		if(sigpending(&pending) == 0) {
+			for(sig = 1; sig < NSIG; sig++) {
+				if(sigismember(&pending, sig) == 1) {
+					if(info != NULL) {
+						memset(info, 0, sizeof(*info));
+						info->si_signo = sig;
+					}
+					return sig;
+				}
+			}
+		}
+
+		if(elapsed.tv_sec > timeout->tv_sec ||
+			(elapsed.tv_sec == timeout->tv_sec &&
+			 elapsed.tv_nsec >= timeout->tv_nsec)) {
+			errno = EAGAIN;
+			return -1;
+		}
+
+		nanosleep(&interval, &remaining);
+		elapsed.tv_nsec += interval.tv_nsec;
+		if(elapsed.tv_nsec >= 1000000000) {
+			elapsed.tv_nsec -= 1000000000;
+			elapsed.tv_sec++;
+		}
+	}
+}
+
+#define sigwaitinfo squashfs_sigwaitinfo
+#define sigtimedwait squashfs_sigtimedwait
+#endif
+
 char *pathname = NULL;
 
 pthread_t info_thread;
